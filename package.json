  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "4.1.11",
    "@tauri-apps/cli": "^2"
